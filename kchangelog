#!/usr/bin/env bash
# kchangelog — monitor de changelogs del kernel Ubuntu con notificaciones Cinnamon
#
# INSTALACIÓN:
#   sudo cp kchangelog /usr/local/bin/
#   sudo chmod +x /usr/local/bin/kchangelog
#   kchangelog --install-service    # instala el timer systemd para el usuario
#
# USO:
#   kchangelog                      # changelog del kernel activo
#   kchangelog 6.8                  # versión específica (major.minor)
#   kchangelog 6.17.0-23            # versión exacta
#   kchangelog --cve                # solo entradas con CVEs
#   kchangelog --last N             # últimas N entradas
#   kchangelog --diff               # diff contra última lectura guardada
#   kchangelog --open               # abrir en $PAGER
#   kchangelog --subscribe active   # suscribirse al kernel activo
#   kchangelog --subscribe 6.8      # suscribirse a versión específica
#   kchangelog --unsubscribe 6.8    # desuscribirse
#   kchangelog --list-subs          # ver suscripciones activas
#   kchangelog --check              # chequear todas las suscripciones (timer)
#   kchangelog --install-service    # instalar timer systemd (cada 6h)
#   kchangelog --remove-service     # desinstalar timer

set -euo pipefail

# --- Configuración ---
CHANGELOG_BASE="https://changelogs.ubuntu.com/changelogs/pool/main/l"
TMPDIR_BASE="/tmp/kchangelog"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kchangelog"
SUBS_FILE="${CONFIG_DIR}/subscriptions"
SEEN_DIR="${CONFIG_DIR}/seen"
SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"

mkdir -p "$TMPDIR_BASE" "$CONFIG_DIR" "$SEEN_DIR"

# --- Helpers ---
info()    { echo "→ $*" >&2; }
success() { echo "✓ $*" >&2; }
err()     { echo "✗ $*" >&2; }

notify() {
    local title="$1" body="$2" urgency="${3:-normal}"
    if command -v notify-send &>/dev/null; then
        DISPLAY="${DISPLAY:-:0}" \
        DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}" \
        notify-send \
            --urgency="$urgency" \
            --icon=system-software-update \
            --app-name="kchangelog" \
            "$title" "$body"
    fi
}

usage() {
    cat <<'EOF'
kchangelog — monitor de changelogs del kernel Ubuntu

LECTURA:
  kchangelog                    Kernel activo
  kchangelog 6.8                Versión específica (major.minor)
  kchangelog 6.17.0-23          Versión exacta
  kchangelog --cve              Solo entradas con CVEs
  kchangelog --last N           Últimas N entradas
  kchangelog --diff             Diff contra última lectura guardada
  kchangelog --open             Abrir en $PAGER
  kchangelog --grep PATTERN     Filtrar entradas que contengan PATTERN
  kchangelog --json             Salida formateada en JSON estructurado

SUSCRIPCIONES:
  kchangelog --subscribe active      Kernel activo
  kchangelog --subscribe 6.8         Versión específica
  kchangelog --unsubscribe 6.8       Desuscribirse
  kchangelog --list-subs             Ver suscripciones

SERVICIO:
  kchangelog --check                 Chequear ahora (usado por el timer)
  kchangelog --install-service       Instalar timer systemd (cada 6h)
  kchangelog --remove-service        Desinstalar timer

OTRAS OPCIONES:
  -l, --list-available               Listar todos los kernels disponibles
  --color always|never|auto          Habilitar/deshabilitar colores (defecto: auto)
  -v, --version                      Mostrar información de versión y salir
  -h, --help                         Mostrar esta ayuda y salir

EOF
    exit 0
}

show_version() {
    cat <<'EOF'
kchangelog (kchangelog) 1.0.0
Copyright (C) 2026 Iván Ezequiel Rodriguez
License GPLv3+: GNU GPL version 3 or later <https://gnu.org/licenses/gpl.html>.
This is free software: you are free to change and redistribute.
There is NO WARRANTY, to the extent permitted by law.

Source: https://github.com/IRodriguez13/kchangelog

Escrito por Iván Ezequiel Rodriguez.
EOF
    exit 0
}

# --- Resolución de versión ---
resolve_interactive_version() {
    local input_ver="$1"

    # Si coincide con el kernel activo, usarlo directamente
    if [[ "$input_ver" == "active" ]]; then
        echo "$(uname -r | sed 's/-generic$//')"
        return
    fi

    # Obtener todas las versiones limpias disponibles en el caché local
    local all_kernels
    all_kernels=$(apt-cache pkgnames linux-image- 2>/dev/null \
        | grep -E '^linux-image-[0-9]' \
        | sed -E 's/^linux-image-//; s/-(generic|dbgsym|lowlatency|aws|gcp|azure|oem|oracle|ibm|gke|unsigned)//g' \
        | grep -E '^[0-9]' \
        | sort -V -u)

    if [[ -z "$all_kernels" ]]; then
        # Si no hay caché, retornar el input tal cual
        echo "$input_ver"
        return
    fi

    # Buscar coincidencias para la familia/prefijo ingresado
    local matches=()
    while IFS= read -r k; do
        [[ -z "$k" ]] && continue
        if [[ "$k" == "$input_ver" ]] || [[ "$k" == "$input_ver".* ]] || [[ "$k" == "$input_ver"-* ]]; then
            matches+=("$k")
        fi
    done <<< "$all_kernels"

    local num_matches=${#matches[@]}

    if [[ $num_matches -eq 0 ]]; then
        # Ninguna coincidencia, devolver el valor del input
        echo "$input_ver"
        return
    fi

    if [[ $num_matches -eq 1 ]]; then
        # Exactamente una coincidencia
        echo "${matches[0]}"
        return
    fi

    # Múltiples coincidencias: preguntar de forma interactiva si es una TTY y no estamos en modo JSON
    if [[ -t 0 && -t 1 && $JSON_OUTPUT -eq 0 ]]; then
        echo "Múltiples versiones encontradas para la familia '$input_ver':" >&2
        local i=1
        for match in "${matches[@]}"; do
            echo "  $i) $match" >&2
            ((i++))
        done
        echo "  a) Todas (suscribirse/monitorear todas)" >&2

        local choice
        while true; do
            read -rp "Selecciona una opción (1-$num_matches o 'a'): " choice < /dev/tty
            if [[ "$choice" == "a" ]]; then
                echo "${matches[@]}"
                return
            elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 && $choice -le $num_matches ]]; then
                echo "${matches[choice-1]}"
                return
            fi
        done
    else
        # No interactivo o modo JSON, usar la más reciente
        echo "${matches[-1]}"
    fi
}

find_pkg_ver() {
    local ver="$1"
    local major_minor
    major_minor=$(echo "$ver" | cut -d. -f1,2)

    # Si coincide con el kernel activo, usarlo directamente
    local active
    active=$(uname -r)
    if [[ "$ver" == "${active%-generic}" || "$ver" == "$active" ]]; then
        apt-cache show "linux-image-${active}" 2>/dev/null \
            | grep "^Version:" | head -1 | awk '{print $2}' || true
        return
    fi

    # Buscar en paquetes disponibles para ese major.minor
    apt-cache search "^linux-image-${major_minor}" 2>/dev/null \
        | awk '{print $1}' \
        | while read -r pkg; do
            apt-cache show "$pkg" 2>/dev/null \
                | grep "^Version:" | head -1 | awk '{print $2}'
          done \
        | sort -V | tail -1 || true
}

build_urls() {
    local ver="$1" pkg_ver="$2"
    local major_minor
    major_minor=$(echo "$ver" | cut -d. -f1,2)

    local urls=()
    if [[ -n "$pkg_ver" ]]; then
        urls+=(
            "${CHANGELOG_BASE}/linux-hwe-${major_minor}/linux-hwe-${major_minor}_${pkg_ver}/changelog"
            "${CHANGELOG_BASE}/linux/linux_${pkg_ver}/changelog"
        )
    fi
    urls+=(
        "${CHANGELOG_BASE}/linux-hwe-${major_minor}/linux-hwe-${major_minor}_${ver}/changelog"
        "${CHANGELOG_BASE}/linux/linux_${ver}/changelog"
    )
    printf '%s\n' "${urls[@]}"
}

# --- Descarga ---
download_changelog() {
    local ver="$1"
    local out_file="${TMPDIR_BASE}/changelog-${ver//\//_}"
    local pkg_ver
    pkg_ver=$(find_pkg_ver "$ver")

    [[ -n "$pkg_ver" ]] && info "Versión del paquete: $pkg_ver"

    while IFS= read -r url; do
        info "Intentando: $url"
        if curl -fsSL --max-time 20 -o "$out_file" "$url" 2>/dev/null; then
            if ! head -1 "$out_file" | grep -qi "<!DOCTYPE\|<html"; then
                info "Guardado en: $out_file"
                echo "$out_file"
                return 0
            fi
        fi
    done < <(build_urls "$ver" "$pkg_ver")

    err "No se pudo descargar el changelog para $ver"
    err "Buscalo manualmente en: ${CHANGELOG_BASE}/"
    return 1
}

# --- Filtros ---
filter_cve() {
    awk '
        /^linux/ { block = $0 "\n"; next }
        { block = block $0 "\n" }
        /^ -- / {
            if (block ~ /CVE-[0-9]{4}-[0-9]+/) print block
            block = ""
        }
    '
}

filter_last_n() {
    local n="$1"
    awk -v n="$n" '
        /^ -- / { count++ }
        { print }
        count >= n { exit }
    '
}

filter_grep() {
    local pattern="$1"
    awk -v pat="$pattern" '
        BEGIN { IGNORECASE = 1 }
        /^linux/ {
            if (block != "") {
                if (block ~ pat) printf "%s", block
            }
            block = $0 "\n"
            next
        }
        { block = block $0 "\n" }
        /^ -- / {
            if (block ~ pat) printf "%s", block
            block = ""
        }
        END {
            if (block != "" && block ~ pat) printf "%s", block
        }
    '
}

to_json() {
    awk '
        BEGIN {
            print "["
            first_entry = 1
            first_block = 1
        }
        
        /^linux/ {
            if (!first_entry) {
                print_entry()
            }
            first_entry = 0
            
            pkg = $1
            # Extraer versión dentro de paréntesis
            match($0, /\([^)]+\)/)
            ver = (RLENGTH > 0) ? substr($0, RSTART + 1, RLENGTH - 2) : "unknown"
            
            # Extraer urgencia
            match($0, /urgency=[a-zA-Z0-9_-]+/)
            urg = (RLENGTH > 0) ? substr($0, RSTART + 8, RLENGTH - 8) : "unknown"
            
            changes_count = 0
            cve_count = 0
            delete changes
            delete cves
            delete cve_seen
            next
        }
        
        /^ -- / {
            # Extraer autor y fecha
            sig = substr($0, 5)
            # Buscar la fecha (comienza después de dos espacios consecutivos)
            match(sig, /  [^ ]+/)
            if (RLENGTH > 0) {
                author = substr(sig, 1, RSTART - 1)
                date = substr(sig, RSTART + 2)
            } else {
                author = sig
                date = ""
            }
            # Limpiar comillas para JSON válido
            gsub(/"/, "\\\"", author)
            gsub(/"/, "\\\"", date)
            next
        }
        
        # Líneas de cambios (iniciadas con espacios)
        /^[ ]+[^ ]/ {
            line = $0
            # Trim de espacios al inicio/fin
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            gsub(/"/, "\\\"", line)
            changes[changes_count++] = line
            
            # Buscar CVEs
            str = $0
            while (match(str, /CVE-[0-9]{4}-[0-9]+/)) {
                cve = substr(str, RSTART, RLENGTH)
                if (!cve_seen[cve]) {
                    cves[cve_count++] = cve
                    cve_seen[cve] = 1
                }
                str = substr(str, RSTART + RLENGTH)
            }
        }
        
        function print_entry() {
            if (!first_block) printf ",\n"
            first_block = 0
            
            printf "  {\n"
            printf "    \"package\": \"%s\",\n", pkg
            printf "    \"version\": \"%s\",\n", ver
            printf "    \"urgency\": \"%s\",\n", urg
            printf "    \"author\": \"%s\",\n", author
            printf "    \"date\": \"%s\",\n", date
            
            # Imprimir CVEs
            printf "    \"cves\": ["
            for (i = 0; i < cve_count; i++) {
                printf "\"%s\"", cves[i]
                if (i < cve_count - 1) printf ", "
            }
            printf "],\n"
            
            # Imprimir cambios
            printf "    \"changes\": [\n"
            for (i = 0; i < changes_count; i++) {
                printf "      \"%s\"", changes[i]
                if (i < changes_count - 1) printf ",\n"
                else printf "\n"
            }
            printf "    ]\n"
            printf "  }"
        }
        
        END {
            if (!first_entry) {
                print_entry()
                printf "\n"
            }
            print "]"
        }
    '
}

colorize() {
    if [[ $USE_COLOR -eq 0 ]]; then
        cat
        return
    fi
    awk '
        # Cabecera de paquete
        /^linux[a-z0-9_-]* \([0-9]/ {
            print "\033[1;36m" $0 "\033[0m"
            next
        }
        # Firma de autor
        /^ -- / {
            print "\033[90m" $0 "\033[0m"
            next
        }
        # Línea estándar
        {
            line = $0
            # Resaltar CVEs en rojo
            gsub(/CVE-[0-9]{4}-[0-9]+/, "\033[1;31m&\033[0m", line)
            # Resaltar urgencia alta/crítica en amarillo
            gsub(/urgency=(high|critical)/, "\033[1;33m&\033[0m", line)
            # Resaltar urgencia media/baja en verde
            gsub(/urgency=(medium|low)/, "\033[1;32m&\033[0m", line)
            print line
        }
    '
}

# --- Diff ---
do_diff() {
    local ver="$1" out_file="$2"
    local seen_file="${SEEN_DIR}/${ver//\//_}"

    if [[ ! -f "$seen_file" ]]; then
        info "Primera lectura de $ver — guardando como base"
        cp "$out_file" "$seen_file"
        cat "$out_file"
        return
    fi

    if diff -q "$seen_file" "$out_file" &>/dev/null; then
        success "Sin cambios desde la última lectura"
    else
        diff --color=always -u "$seen_file" "$out_file" || true
        echo ""
        read -rp "¿Actualizar base de comparación? [s/N] " resp
        if [[ "${resp,,}" == "s" ]]; then
            cp "$out_file" "$seen_file"
            success "Base actualizada"
        fi
    fi
}

# --- Suscripciones ---
subscribe() {
    local ver="$1"
    [[ "$ver" == "active" ]] && ver="$(uname -r | sed 's/-generic$//')"
    touch "$SUBS_FILE"
    if grep -qx "$ver" "$SUBS_FILE" 2>/dev/null; then
        info "Ya estás suscrito a $ver"
    else
        echo "$ver" >> "$SUBS_FILE"
        success "Suscrito a $ver"
        info "Instalá el timer si no lo hiciste: kchangelog --install-service"
    fi
}

unsubscribe() {
    local ver="$1"
    [[ "$ver" == "active" ]] && ver="$(uname -r | sed 's/-generic$//')"
    if [[ ! -f "$SUBS_FILE" ]] || ! grep -qx "$ver" "$SUBS_FILE"; then
        info "No estabas suscrito a $ver"
        return
    fi
    sed -i "/^${ver//\./\\.}$/d" "$SUBS_FILE"
    success "Desuscrito de $ver"
}

list_subs() {
    if [[ ! -f "$SUBS_FILE" ]] || [[ ! -s "$SUBS_FILE" ]]; then
        info "No hay suscripciones activas"
        return
    fi
    echo "Suscripciones activas:"
    while IFS= read -r ver; do
        [[ -z "$ver" ]] && continue
        echo "  • $ver"
    done < "$SUBS_FILE"
}

# --- Listar kernels disponibles ---
list_available() {
    info "Obteniendo lista de kernels disponibles..."
    local kernels
    kernels=$(apt-cache pkgnames linux-image- 2>/dev/null \
        | grep -E '^linux-image-[0-9]' \
        | sed -E 's/^linux-image-//; s/-(generic|dbgsym|lowlatency|aws|gcp|azure|oem|oracle|ibm|gke|unsigned)//g' \
        | grep -E '^[0-9]' \
        | sort -V -u)

    if [[ -z "$kernels" ]]; then
        err "No se encontraron kernels en el caché de apt. Intentá correr: sudo apt update"
        exit 1
    fi

    echo "Kernels disponibles para monitoreo:"
    echo "$kernels" | column 2>/dev/null || echo "$kernels"
}

# --- Check (usado por el timer) ---
do_check() {
    [[ ! -f "$SUBS_FILE" ]] && return

    while IFS= read -r ver; do
        [[ -z "$ver" ]] && continue
        info "Chequeando $ver..."

        local out_file
        out_file=$(download_changelog "$ver") || continue

        local seen_file="${SEEN_DIR}/${ver//\//_}"

        if [[ ! -f "$seen_file" ]]; then
            cp "$out_file" "$seen_file"
            info "$ver: base guardada (primera vez)"
            continue
        fi

        if diff -q "$seen_file" "$out_file" &>/dev/null; then
            info "$ver: sin cambios"
            continue
        fi

        # Detectar CVEs nuevos
        local new_cves
        new_cves=$(diff "$seen_file" "$out_file" \
            | grep "^>" \
            | grep -oP 'CVE-[0-9]{4}-[0-9]+' \
            | sort -u || true)

        # Detectar nueva entrada de versión
        local new_entry
        new_entry=$(diff "$seen_file" "$out_file" \
            | grep "^> linux" | head -1 | sed 's/^> //' || true)

        if [[ -n "$new_cves" ]]; then
            local count cve_list
            count=$(echo "$new_cves" | wc -l)
            cve_list=$(echo "$new_cves" | tr '\n' ' ')
            notify \
                "Kernel $ver — $count CVE(s) nuevos" \
                "${cve_list}\n\nCorré: kchangelog $ver --cve" \
                "critical"
            success "$ver: $count CVE(s) nuevos — notificación enviada"
        elif [[ -n "$new_entry" ]]; then
            notify \
                "Kernel $ver — Update disponible" \
                "$new_entry\n\nCorré: kchangelog $ver --diff" \
                "normal"
            success "$ver: update disponible — notificación enviada"
        fi

        cp "$out_file" "$seen_file"

    done < "$SUBS_FILE"
}

# --- Servicio systemd ---
install_service() {
    mkdir -p "$SYSTEMD_USER_DIR"

    cat > "${SYSTEMD_USER_DIR}/kchangelog.service" <<EOF
[Unit]
Description=kchangelog — chequeo de changelogs del kernel
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kchangelog --check
Environment=DISPLAY=:0
EOF

    cat > "${SYSTEMD_USER_DIR}/kchangelog.timer" <<EOF
[Unit]
Description=kchangelog — chequeo periódico cada 6 horas

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable --now kchangelog.timer
    success "Timer instalado — chequea cada 6 horas"
    info "Estado:   systemctl --user status kchangelog.timer"
    info "Log:      journalctl --user -u kchangelog.service"
}

remove_service() {
    systemctl --user disable --now kchangelog.timer 2>/dev/null || true
    rm -f \
        "${SYSTEMD_USER_DIR}/kchangelog.service" \
        "${SYSTEMD_USER_DIR}/kchangelog.timer"
    systemctl --user daemon-reload
    success "Timer desinstalado"
}

# --- Pipeline de salida ---
run_pipeline() {
    local out_file="$1"

    local cmd="cat \"$out_file\""
    [[ $CVE_ONLY -eq 1 ]]      && cmd="$cmd | filter_cve"
    [[ -n "$GREP_PATTERN" ]]   && cmd="$cmd | filter_grep \"$GREP_PATTERN\""
    [[ $LAST_N -gt 0 ]]        && cmd="$cmd | filter_last_n \"$LAST_N\""
    [[ $JSON_OUTPUT -eq 1 ]]   && cmd="$cmd | to_json"
    [[ $JSON_OUTPUT -eq 0 ]]   && cmd="$cmd | colorize"

    # Deshabilitar pipefail temporalmente para permitir terminación temprana del pipeline (SIGPIPE)
    set +o pipefail
    if [[ $OPEN_PAGER -eq 1 ]]; then
        eval "$cmd" | ${PAGER:-less -R}
    else
        eval "$cmd"
    fi
    set -o pipefail
}

# --- Parse de argumentos ---
CVE_ONLY=0
LAST_N=0
OPEN_PAGER=0
DO_DIFF=0
TARGET_VER=""
ACTION="read"
COLOR_OPT="auto"
GREP_PATTERN=""
JSON_OUTPUT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cve)             CVE_ONLY=1 ;;
        --open)            OPEN_PAGER=1 ;;
        --diff)            DO_DIFF=1 ;;
        --last)            shift; LAST_N="${1:?'--last requiere un número'}" ;;
        --subscribe)       shift; ACTION="subscribe";   TARGET_VER="${1:?'falta versión'}" ;;
        --unsubscribe)     shift; ACTION="unsubscribe"; TARGET_VER="${1:?'falta versión'}" ;;
        --list-subs)       ACTION="list-subs" ;;
        --check)           ACTION="check" ;;
        --install-service) ACTION="install-service" ;;
        --remove-service)  ACTION="remove-service" ;;
        -l|--list-available) ACTION="list-available" ;;
        --color)           shift; COLOR_OPT="${1:?'--color requiere: always, never o auto'}" ;;
        --color=*)         COLOR_OPT="${1#*=}" ;;
        --grep)            shift; GREP_PATTERN="${1:?'--grep requiere un patrón'}" ;;
        --grep=*)          GREP_PATTERN="${1#*=}" ;;
        --json)            JSON_OUTPUT=1 ;;
        -h|--help)         usage ;;
        -v|--version)      show_version ;;
        -*)                err "Opción desconocida: $1"; exit 1 ;;
        *)                 TARGET_VER="$1" ;;
    esac
    shift
done

# Configuración de colores
USE_COLOR=0
if [[ "$COLOR_OPT" == "always" ]]; then
    USE_COLOR=1
elif [[ "$COLOR_OPT" == "auto" ]]; then
    if [[ -t 1 ]]; then
        USE_COLOR=1
    fi
fi

# --- Dispatch ---
case "$ACTION" in
    subscribe)
        resolved_versions=$(resolve_interactive_version "$TARGET_VER")
        read -r -a ver_array <<< "$resolved_versions"
        for v in "${ver_array[@]}"; do
            subscribe "$v"
        done
        exit 0
        ;;
    unsubscribe)
        resolved_versions=$(resolve_interactive_version "$TARGET_VER")
        read -r -a ver_array <<< "$resolved_versions"
        for v in "${ver_array[@]}"; do
            unsubscribe "$v"
        done
        exit 0
        ;;
    list-subs)       list_subs;                 exit 0 ;;
    check)           do_check;                  exit 0 ;;
    install-service) install_service;           exit 0 ;;
    remove-service)  remove_service;            exit 0 ;;
    list-available)  list_available;            exit 0 ;;
esac

# --- Lectura normal ---
[[ -z "$TARGET_VER" ]] && TARGET_VER="active"
resolved_versions=$(resolve_interactive_version "$TARGET_VER")
read -r -a ver_array <<< "$resolved_versions"

for v in "${ver_array[@]}"; do
    info "Kernel: $v"
    out_file=$(download_changelog "$v")

    if [[ $DO_DIFF -eq 1 ]]; then
        do_diff "$v" "$out_file"
    else
        run_pipeline "$out_file"
    fi

    # Actualizar seen en lectura normal
    cp "$out_file" "${SEEN_DIR}/${v//\//_}"
done
